---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
const services = [['01 / Strategy', 'AI & data strategy', 'Make the right bets with a roadmap shaped around your data, people, and business goals.', '↗'],['02 / Foundation', 'Data platforms', 'Bring fragmented systems into one trusted, secure foundation built to scale.', '◫'],['03 / Intelligence', 'Applied AI', 'Put generative AI, predictive models, and automation to work where they create real value.', '✦']]
const cases = [['Retail','Demand forecasting that learns daily','Unified signals across 14 markets for smarter stock decisions.','28','%'],['Finance','A faster route from insight to action','Embedded intelligence for frontline analysts.','6×',''],['Health','Less admin, more human care','Automation that clears the path for clinical teams.','11k','']]
const steps = [['01','Listen closely','Find the opportunity behind the ask.'],['02','Focus the signal','Set a clear path to measurable value.'],['03','Build together','Ship useful things, early and often.'],['04','Keep moving','Equip your team to go further.']]
---
<BaseLayout title="AI Data Solutions — Intelligence in motion"><header class="nav"><a class="brand" href="#top"><img class="brand-logo" src="/ads-logo.jpeg" alt="AI Data Solutions Ltd" /><span>AI Data Solutions</span></a><nav class="navlinks"><a href="/ai-data-services/">AI &amp; Data</a><a href="#impact">Impact</a><a href="/course-program/">Academy</a><a href="/contact/#contact-form">Talk to an expert →</a></nav></header><main id="top"><section class="hero"><div class="data-lines"><div></div><div></div><div></div><div></div></div><div class="orb"></div><div class="eyebrow mono">Data, designed for decisions</div><h1>Move from <em>data chaos</em><br />to intelligent momentum.</h1><p class="hero-copy">We help ambitious teams turn their most complex data into clear, confident action with AI built for the real world.</p><div class="actions"><a class="button primary" href="/contact/#contact-form">Start a conversation <span class="arrow">↗</span></a><a class="button ghost" href="/#what-we-offer">Explore solutions</a></div><div class="hero-bottom"><span class="scroll mono"><i></i> Scroll to discover</span><div class="hero-stat"><strong>40+ TB</strong><span class="mono">Data made useful each day</span></div></div></section><div class="logo-strip"><span class="mono">Trusted by teams at</span><div class="logos"><span>northstar</span><span>Alto</span><span>orbit</span><span>varia</span><span>HORIZON</span></div></div><section id="what-we-offer"><div class="section-top"><div><div class="kicker mono">What we do</div><h2 class="section-title">Your data has more to say. We help you hear it.</h2></div><p class="intro">From the first pipeline to a company-wide AI strategy, we make useful intelligence feel remarkably straightforward.</p></div><div class="services">{services.map(([number, title, text, icon]) => <article class="service"><div><span class="service-num mono">{number}</span><h3>{title}</h3><p>{text}</p></div><div class="service-icon">{icon}</div></article>)}</div></section><section class="impact" id="impact"><div class="impact-grid"><div><div class="kicker mono">Proof in progress</div><h2 class="section-title">Measurable change, not innovation theatre.</h2></div><div>{cases.map(([sector,title,text,result,suffix]) => <div class="case"><span class="mono">{sector}</span><div><div class="label">{title}</div><p>{text}</p></div><strong>{result}<small>{suffix}</small></strong></div>)}</div></div></section><section class="process" id="approach"><div class="section-top"><div><div class="kicker mono">Our approach</div><h2 class="section-title">Built with you, not dropped on you.</h2></div><p class="intro">We pair sharp technical thinking with a practical delivery model that leaves your team stronger than we found it.</p></div><div class="steps">{steps.map(([number,title,text]) => <div class="step"><b>{number}</b><h3>{title}</h3><p>{text}</p></div>)}</div></section><section class="cta" id="contact"><div class="eyebrow mono">A good next step</div><h2>Ready to make your data<br />work harder for you?</h2><div class="actions"><a class="button primary" href="/contact/#contact-form">Let’s talk <span class="arrow">↗</span></a><a class="button ghost" href="/contact/#contact-form">Contact Us</a></div></section></main><SiteFooter /></BaseLayout>
