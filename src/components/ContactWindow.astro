<dialog id="contact-window" class="contact-window" aria-labelledby="contact-window-title"><div class="contact-window__panel"><button class="contact-window__close" type="button" aria-label="Close contact window" data-close-contact>×</button><span class="course-label">Let’s talk</span><h2 id="contact-window-title">How can we help?</h2><p>Choose a topic and share a short message. Our team will respond using the details you provide.</p><form class="contact-window__form" data-contact-form><fieldset><legend>Topic</legend><label><input type="radio" name="topic" value="Support" checked /> <span>Support</span></label><label><input type="radio" name="topic" value="Business request" /> <span>Business request</span></label><label><input type="radio" name="topic" value="Training" /> <span>Training</span></label></fieldset><label><span>Your email</span><input name="email" type="email" autocomplete="email" required /></label><label><span>Message</span><textarea name="message" rows="4" required></textarea></label><button class="contact-window__submit" type="submit">Send request</button><p class="contact-window__status" role="status" aria-live="polite" data-contact-status></p></form></div></dialog>
<script>
  const dialog = document.querySelector('#contact-window') as HTMLDialogElement | null
  const open = () => { if (dialog && !dialog.open) dialog.showModal() }
  const closeButton = dialog?.querySelector('[data-close-contact]'); const form = dialog?.querySelector('[data-contact-form]') as HTMLFormElement | null; const status = dialog?.querySelector('[data-contact-status]')
  document.addEventListener('click', (event) => { const trigger = (event.target as Element).closest('[data-open-contact]'); if (!trigger) return; event.preventDefault(); open() })
  if (window.location.hash === '#contact-form') open()
  closeButton?.addEventListener('click', () => dialog?.close()); dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close() })
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (status) status.textContent = 'Thank you. Your request is ready to be connected to the AI Data Solutions contact workflow.'; form.reset() })
</script>
