  const originals = new WeakMap<Text, string>()
  const applyLanguage = (language: 'en' | 'bg') => {
    document.documentElement.lang = language
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
    const nodes: Text[] = []; let node: Node | null
    while ((node = walker.nextNode())) nodes.push(node as Text)
    nodes.forEach((text) => { const original = originals.get(text) || text.nodeValue || ''; originals.set(text, original); const key = original.trim(); if (key && translations[key]) text.nodeValue = original.replace(key, language === 'bg' ? translations[key] : key) })
    languageToggle?.classList.toggle('is-bulgarian', language === 'bg'); languageToggle?.setAttribute('aria-label', language === 'bg' ? 'Switch to English' : 'Switch to Bulgarian')
  }
  const savedLanguage = sessionStorage.getItem('ads-language') as 'en' | 'bg' | null
  if (savedLanguage) applyLanguage(savedLanguage)
  languageToggle?.addEventListener('click', () => { const next = document.documentElement.lang === 'bg' ? 'en' : 'bg'; sessionStorage.setItem('ads-language', next); applyLanguage(next) })
</script>
